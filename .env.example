# ===================================
# PICCO - Environment Variables
# ===================================
# Copy this file to .env.local and fill in your actual credentials
# NEVER commit .env.local to version control!
# ===================================

# ===== FIREBASE CONFIGURATION =====
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ===== GOOGLE OAUTH 2.0 =====
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# Production: https://picco.com/auth/callback

# ===== SAFARICOM DARAJA API (M-PESA) =====
# Get from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret

# Business Short Code (Paybill/Till Number)
MPESA_SHORTCODE=174379
# For STK Push - obtain from Safaricom
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Your M-Pesa registered phone number (254723525608)
MPESA_PHONE=254723525608
MPESA_PHONE_SHORT=0723525608

# Callback URL for payment notifications
# Development: use ngrok for testing
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/callback
MPESA_TIMEOUT_URL=https://your-domain.com/api/payments/timeout

# M-Pesa Environment
MPESA_ENV=sandbox
# For production: MPESA_ENV=production

# ===== AI API INTEGRATIONS =====
# Claude API (Anthropic)
CLAUDE_API_KEY=sk-ant-your_claude_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# OpenAI API (GPT-4)
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4-turbo

# ===== EMAIL SERVICE =====
# SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@picco.com

# OR Nodemailer (Gmail with App Password)
NODEMAILER_USER=your_email@gmail.com
NODEMAILER_PASS=your_gmail_app_password_16_chars
NODEMAILER_SERVICE=gmail

# ===== GOOGLE SHEETS API =====
# For transaction logging and admin dashboard
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key
GOOGLE_SHEETS_ID=your_spreadsheet_id
# Create a service account: https://console.cloud.google.com

# ===== GITHUB API =====
# For Website Builder integration
GITHUB_PERSONAL_TOKEN=ghp_your_github_personal_access_token
GITHUB_API_ENDPOINT=https://api.github.com

# ===== NETLIFY API =====
# For one-click website deployment
NETLIFY_AUTH_TOKEN=your_netlify_auth_token
NETLIFY_SITE_ID=your_netlify_site_id

# ===== DATABASE =====
# MongoDB (Alternative to Firebase)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/picco
# OR Firebase (recommended - already configured above)

# ===== SERVER CONFIGURATION =====
NODE_ENV=development
# For production: NODE_ENV=production

BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
# Production: https://api.picco.com

FRONTEND_URL=http://localhost:3000
# Production: https://picco.com

# ===== JWT SECRETS (Backend) =====
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_EXPIRE=7d

# OTP Settings
OTP_EXPIRE=10m
OTP_LENGTH=6

# ===== SUBSCRIPTION SETTINGS =====
PRO_TIER_WEEKLY=10
# USD per week
PRO_TIER_MONTHLY=35
# USD per month

PLUS_TIER_WEEKLY=25
# USD per week
PLUS_TIER_MONTHLY=98
# USD per month

# Subscription lock duration (seconds)
SUBSCRIPTION_LOCK_WEEKLY=604800
# 7 days in seconds
SUBSCRIPTION_LOCK_MONTHLY=2592000
# 30 days in seconds

# ===== CURRENCY EXCHANGE RATES =====
# Real-time rates API
EXCHANGE_RATE_API=https://api.exchangerate-api.com/v4/latest/USD

# Minimum acceptable rates (for payment validation)
KES_TO_USD_MIN=130
# 1 USD = 130 KES minimum
EUR_TO_USD=1.1
# Adjust based on current rates
GBP_TO_USD=1.27
# Adjust based on current rates
JPY_TO_USD=0.0067
# Adjust based on current rates

# ===== ADMIN SETTINGS =====
ADMIN_EMAIL=splenderkimani@gmail.com
ADMIN_PHONE=0723525608
COMPANY_NAME=PICCO COMPANIES

# ===== SURVEY SETTINGS =====
SURVEY_PAYOUT_AMOUNT=5000
# Amount in KES
SURVEY_PAYOUT_RECIPIENT=0723525608
# Only visible to admin

# ===== SEO & BRANDING =====
SITE_NAME=PICCO
SITE_DESCRIPTION=AI-Powered Educational Platform with Website Builder
SITE_DOMAIN=picco.com
SITE_KEYWORDS=AI, Education, Website Builder, Q&A, Video Transcription

# ===== LOGGING =====
LOG_LEVEL=info
# Options: error, warn, info, debug

# ===== SECURITY =====
CORS_ORIGIN=http://localhost:3000
# Production: https://picco.com

CORS_CREDENTIALS=true

# Rate limiting (requests per minute)
RATE_LIMIT=60

# ===== ENCRYPTION =====
ENCRYPTION_KEY=your_32_char_encryption_key_for_sensitive_data

# ===== MAPBOX (For location features - Optional) =====
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token

# ===== SENTRY (Error tracking - Optional) =====
VITE_SENTRY_DSN=https://your_sentry_dsn

# ===== STRIPE (Alternative payment - Optional) =====
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# ===== TWILIO (SMS/Voice - Optional) =====
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
